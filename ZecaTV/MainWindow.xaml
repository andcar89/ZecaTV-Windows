<Window x:Class="ZecaTV.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        xmlns:ui="clr-namespace:ZecaTV.UI"
        xmlns:models="clr-namespace:ZecaTV.Models"
        xmlns:loc="clr-namespace:ZecaTV.Localization"
        Title="ZecaTV"
        Width="1280" Height="760" MinWidth="960" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing">

    <Window.Resources>
        <!-- Rows of the fullscreen side lists: never take focus, selection always shown as active. -->
        <Style x:Key="SideListItem" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="CategoryTemplate" DataType="{x:Type models:Category}">
            <DockPanel Height="38">
                <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" Foreground="{StaticResource SubTextBrush}"
                           FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0" />
                <TextBlock Text="{Binding Label}" FontSize="14" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Label}" />
            </DockPanel>
        </DataTemplate>

        <DataTemplate x:Key="ChannelTemplate" DataType="{x:Type ui:ChannelItem}">
            <Grid Height="56">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="46" />
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- "Now playing" marker -->
                <Border x:Name="PlayingBar" Width="3" CornerRadius="1.5" Margin="-6,8,0,8"
                        HorizontalAlignment="Left" Background="#4FA3FF" Visibility="Collapsed" />

                <!-- Movies/episodes don't have a stable playlist position (Number is always 0 for them) -->
                <TextBlock x:Name="NumberText" Text="{Binding Number}" Foreground="{StaticResource SubTextBrush}" FontSize="13"
                           VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0" />

                <Border Grid.Column="1" Width="58" Height="36" CornerRadius="4" Background="#0DFFFFFF">
                    <Grid>
                        <TextBlock x:Name="InitialText" Text="{Binding Initial}" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Image Source="{Binding Logo}" Stretch="Uniform" Margin="3"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Grid>
                </Border>

                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="12,0,6,0">
                    <TextBlock x:Name="NameText" Text="{Binding Name}" FontSize="15"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                    <TextBlock Text="{Binding Subtitle}" FontSize="11" Margin="0,2,0,0"
                               Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0">
                    <!-- Xtream catch-up available for this channel -->
                    <TextBlock x:Name="CatchupIcon" Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                               Foreground="{StaticResource MutedTextBrush}" Margin="0,0,6,0" VerticalAlignment="Center"
                               Visibility="Collapsed" ToolTip="{x:Static loc:Strings.CatchupAvailableTooltip}" />
                    <TextBlock x:Name="FavoriteStar" Text="★" FontSize="15" Foreground="#FFC83D"
                               VerticalAlignment="Center" Visibility="Collapsed" ToolTip="{x:Static loc:Strings.FavoriteTooltip}" />
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                    <Setter TargetName="FavoriteStar" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Channel.HasCatchup}" Value="True">
                    <Setter TargetName="CatchupIcon" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasLogo}" Value="True">
                    <Setter TargetName="InitialText" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                    <Setter TargetName="PlayingBar" Property="Visibility" Value="Visible" />
                    <Setter TargetName="NameText" Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Number}" Value="0">
                    <Setter TargetName="NumberText" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- One row of the TV Shows tab's show grid (before a show is opened to its episode list —
             see ChannelTemplate, reused for the episode list itself once a show is opened). -->
        <DataTemplate x:Key="ShowTemplate" DataType="{x:Type ui:ShowItem}">
            <Grid Height="56">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="58" Height="36" CornerRadius="4" Background="#0DFFFFFF" Margin="10,0,0,0">
                    <Grid>
                        <TextBlock x:Name="ShowInitialText" Text="{Binding Initial}" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Image Source="{Binding Cover}" Stretch="Uniform" Margin="3"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Grid>
                </Border>

                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="15" VerticalAlignment="Center"
                           Margin="12,0,6,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />

                <!-- Chevron hinting that this row opens into an episode list -->
                <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                           Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasCover}" Value="True">
                    <Setter TargetName="ShowInitialText" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ===== Live TV / Movies / TV Shows section tabs (above the category list) ===== -->
        <Style x:Key="SectionTabButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="0,7" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="SectionTabButtonSelected" TargetType="Button" BasedOn="{StaticResource SectionTabButton}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== Top bar ===== -->
        <Border x:Name="TopBar" Background="{StaticResource PanelBrush}" Padding="18,10">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Left" FontSize="22" FontWeight="Bold" VerticalAlignment="Center">
                    <Run Text="Zeca" /><Run Text="TV" Foreground="#4FA3FF" />
                </TextBlock>
                <ComboBox x:Name="PlaylistSwitcher" DockPanel.Dock="Left" Width="200" Margin="20,0,0,0"
                          DisplayMemberPath="Name" SelectionChanged="PlaylistSwitcher_SelectionChanged"
                          Visibility="Collapsed" ToolTip="{x:Static loc:Strings.SwitchPlaylistTooltip}" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Grid Width="220" Margin="0,0,10,0" VerticalAlignment="Center">
                        <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_KeyDown" />
                        <TextBlock x:Name="SearchPlaceholder" Text="{x:Static loc:Strings.SearchPlaceholder}" IsHitTestVisible="False"
                                   Foreground="{StaticResource MutedTextBrush}" Margin="12,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                    <Button x:Name="ReloadButton" Content="{x:Static loc:Strings.ReloadButton}" Margin="0,0,8,0" Click="ReloadButton_Click"
                            ToolTip="{x:Static loc:Strings.ReloadButtonTooltip}" />
                    <Button x:Name="GuideButton" Content="{x:Static loc:Strings.TvGuideButton}" Margin="0,0,8,0" Click="GuideButton_Click"
                            ToolTip="{x:Static loc:Strings.TvGuideButtonTooltip}" />
                    <Button x:Name="SettingsButton" Content="{x:Static loc:Strings.SettingsButton}" Click="SettingsButton_Click" />
                </StackPanel>
                <TextBlock x:Name="StatusText" Margin="24,0,16,0" VerticalAlignment="Center"
                           Foreground="{StaticResource SubTextBrush}" FontSize="13" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <!--
            ===== Main content =====
            IMPORTANT (WPF "airspace"): the video is a native window. Nothing WPF can ever draw ON TOP
            of it — overlays over the video must go INSIDE the VideoView (it shows them in a
            transparent window of their own). That's why the welcome panel below hides this whole
            grid (Visibility=Hidden, never Collapsed — see MainWindow.xaml.cs) instead of covering it.
        -->
        <Grid x:Name="ContentGrid" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Categories -->
            <Border x:Name="CategoryPanel" Width="240" Background="{StaticResource PanelAltBrush}">
                <DockPanel>
                    <UniformGrid x:Name="SectionTabs" DockPanel.Dock="Top" Columns="3" Margin="12,12,12,0">
                        <Button x:Name="LiveSectionButton" Content="{x:Static loc:Strings.SectionLive}" Tag="Live"
                                Style="{StaticResource SectionTabButtonSelected}" Margin="0,0,3,0" Click="SectionButton_Click" />
                        <Button x:Name="MoviesSectionButton" Content="{x:Static loc:Strings.SectionMovies}" Tag="Movies"
                                Style="{StaticResource SectionTabButton}" Margin="3,0,3,0" Click="SectionButton_Click" IsEnabled="False" />
                        <Button x:Name="ShowsSectionButton" Content="{x:Static loc:Strings.SectionShows}" Tag="Shows"
                                Style="{StaticResource SectionTabButton}" Margin="3,0,0,0" Click="SectionButton_Click" IsEnabled="False" />
                    </UniformGrid>
                    <TextBlock x:Name="CategoriesHeaderText" DockPanel.Dock="Top" Text="{x:Static loc:Strings.CategoriesHeader}" Margin="18,16,18,8" FontSize="11"
                               FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" />
                    <ListBox x:Name="CategoryList" ItemTemplate="{StaticResource CategoryTemplate}"
                             SelectionChanged="CategoryList_SelectionChanged"
                             ContextMenuOpening="CategoryList_ContextMenuOpening">
                        <!-- Filled in per category (M3U only) by CategoryList_ContextMenuOpening. -->
                        <ListBox.ContextMenu>
                            <ContextMenu />
                        </ListBox.ContextMenu>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Channels -->
            <Border x:Name="ChannelPanel" Grid.Column="1" Width="390" Background="{StaticResource PanelBrush}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="18,16,18,8" LastChildFill="True">
                        <!-- Visible only while browsing one show's episode list (TV Shows tab) -->
                        <Button x:Name="ShowsBackButton" DockPanel.Dock="Left" Content="&#xE72B;" FontFamily="Segoe MDL2 Assets"
                                Padding="8,4" Margin="0,0,10,0" Visibility="Collapsed" Click="ShowsBackButton_Click"
                                ToolTip="{x:Static loc:Strings.BackToShowsTooltip}" />
                        <TextBlock x:Name="ChannelHeader" FontSize="11" VerticalAlignment="Center"
                                   FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}"
                                   TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <ListBox x:Name="ChannelList" ItemTemplate="{StaticResource ChannelTemplate}"
                             VirtualizingPanel.ScrollUnit="Item"
                             PreviewMouseLeftButtonUp="ChannelList_PreviewMouseLeftButtonUp"
                             KeyDown="ChannelList_KeyDown"
                             ContextMenuOpening="ChannelList_ContextMenuOpening">
                        <!-- Filled in per channel by ChannelList_ContextMenuOpening. -->
                        <ListBox.ContextMenu>
                            <ContextMenu />
                        </ListBox.ContextMenu>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Player -->
            <Grid x:Name="PlayerArea" Grid.Column="2" Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border x:Name="VideoFrame" Background="Black">
                    <vlc:VideoView x:Name="VideoView" Background="Black" Loaded="VideoView_Loaded">
                        <!--
                            Overlay content. Background is 1/255 black, not Transparent: fully transparent
                            pixels of the overlay window let clicks fall through, and then double-click /
                            mouse wheel / mouse-move would never reach us.
                        -->
                        <Grid x:Name="Overlay" Background="#01000000"
                              TextElement.Foreground="{StaticResource TextBrush}"
                              TextElement.FontFamily="Segoe UI"
                              PreviewMouseDown="Overlay_PreviewMouseDown"
                              MouseLeftButtonDown="Overlay_MouseLeftButtonDown"
                              MouseMove="Overlay_MouseMove"
                              MouseWheel="Overlay_MouseWheel"
                              PreviewKeyDown="Window_PreviewKeyDown"
                              ContextMenuOpening="Overlay_ContextMenuOpening">
                            <!-- Filled in per playback state by Overlay_ContextMenuOpening. -->
                            <Grid.ContextMenu>
                                <ContextMenu />
                            </Grid.ContextMenu>

                            <TextBlock x:Name="IdleHint" Text="{x:Static loc:Strings.SelectChannelHint}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontSize="16" Foreground="{StaticResource MutedTextBrush}" />

                            <Border x:Name="StatusBadge" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Background="#D9111318" CornerRadius="8" Padding="22,14" Visibility="Collapsed">
                                <TextBlock x:Name="StatusLabel" FontSize="16" Foreground="{StaticResource TextBrush}"
                                           TextAlignment="Center" TextWrapping="Wrap" MaxWidth="460" />
                            </Border>

                            <!-- Short on-screen messages: volume, mute, favorite added/removed -->
                            <Border x:Name="OsdBadge" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="24" Background="#D9111318" CornerRadius="6" Padding="14,8"
                                    Visibility="Collapsed">
                                <TextBlock x:Name="OsdLabel" FontSize="15" Foreground="{StaticResource TextBrush}" />
                            </Border>

                            <!-- Persistent while watching Xtream catch-up instead of live (windowed and fullscreen alike) -->
                            <Border x:Name="CatchupBadge" HorizontalAlignment="Left" VerticalAlignment="Top"
                                    Margin="24" Background="#D9111318" CornerRadius="6" Padding="14,8"
                                    Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="CatchupLabel" FontSize="14" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" MaxWidth="360" />
                                    <Button Content="{x:Static loc:Strings.BackToLiveButton}" Margin="14,0,0,0"
                                            Click="BackToLiveButton_Click" />
                                </StackPanel>
                            </Border>

                            <!-- Fullscreen info bar -->
                            <Border x:Name="InfoBar" VerticalAlignment="Bottom" Background="#E6111318"
                                    Padding="32,10" Visibility="Collapsed">
                                <DockPanel>
                                    <Border DockPanel.Dock="Left" Width="128" Height="80" CornerRadius="6"
                                            Background="#0DFFFFFF" Margin="0,0,20,0">
                                        <Image x:Name="InfoLogo" Source="{Binding Logo}" Stretch="Uniform" Margin="5"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Border>
                                    <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" MaxWidth="440">
                                        <TextBlock x:Name="InfoEpgNowText" FontSize="14" TextAlignment="Right"
                                                   TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                                        <TextBlock x:Name="InfoEpgNextText" FontSize="13" Margin="0,4,0,0" TextAlignment="Right"
                                                   Foreground="{StaticResource SubTextBrush}" TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                                        <TextBlock x:Name="InfoEpgAfterText" FontSize="13" Margin="0,4,0,0" TextAlignment="Right"
                                                   Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                                    </StackPanel>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock FontSize="24" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                            <Run x:Name="InfoNumber" Foreground="#4FA3FF" /><Run Text="  " /><Run x:Name="InfoName" /><Run x:Name="InfoStar" Foreground="#FFC83D" />
                                        </TextBlock>
                                        <TextBlock x:Name="InfoGroup" FontSize="14" Margin="0,4,0,0"
                                                   Foreground="{StaticResource SubTextBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- Fullscreen VOD (Movie/episode) transport bar — shown instead of InfoBar for
                                 that content (see ShowInfoBar/UpdateVodControls); Live TV never shows this.
                                 Persistent (no auto-hide) rather than sharing InfoBar's timer, since a
                                 seek bar is something to look at and use, not a passing toast. -->
                            <Border x:Name="VodControlBar" VerticalAlignment="Bottom" Background="#E6111318"
                                    Padding="32,14" Visibility="Collapsed">
                                <DockPanel LastChildFill="True">
                                    <Button x:Name="FullscreenPlayPauseButton" DockPanel.Dock="Left" Width="40" Height="40"
                                            Margin="0,0,18,0" Padding="0" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                            Click="PlayPauseButton_Click" />
                                    <TextBlock x:Name="FullscreenSeekTimeText" DockPanel.Dock="Right" Margin="18,0,0,0"
                                               VerticalAlignment="Center" Foreground="{StaticResource SubTextBrush}"
                                               FontSize="13" MinWidth="110" TextAlignment="Right" />
                                    <Slider x:Name="FullscreenSeekSlider" VerticalAlignment="Center" Minimum="0" Maximum="0" Value="0"
                                            IsMoveToPointEnabled="True"
                                            PreviewMouseLeftButtonDown="SeekSlider_PreviewMouseLeftButtonDown"
                                            PreviewMouseLeftButtonUp="SeekSlider_PreviewMouseLeftButtonUp"
                                            PreviewKeyUp="SeekSlider_PreviewKeyUp" />
                                </DockPanel>
                            </Border>

                            <!--
                                Fullscreen side panel (← opens channels, ← again adds categories; like the
                                Android player's overlay sidebars). The lists are never focused: MainWindow
                                moves their selection itself, so keyboard handling doesn't depend on which of
                                the two windows (main / overlay) currently has focus.
                            -->
                            <Border x:Name="SidePanel" HorizontalAlignment="Left" Background="#F2111318"
                                    Visibility="Collapsed">
                                <DockPanel>
                                    <Border x:Name="SideCategoryColumn" DockPanel.Dock="Left" Width="250"
                                            Background="#F21A1D24" Visibility="Collapsed">
                                        <DockPanel>
                                            <TextBlock x:Name="SideCategoriesHeaderText" DockPanel.Dock="Top" Text="{x:Static loc:Strings.CategoriesHeader}" Margin="18,20,18,8" FontSize="11"
                                                       FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" />
                                            <ListBox x:Name="SideCategoryList" Focusable="False"
                                                     ItemTemplate="{StaticResource CategoryTemplate}"
                                                     ItemContainerStyle="{StaticResource SideListItem}"
                                                     PreviewMouseLeftButtonUp="SideCategoryList_PreviewMouseLeftButtonUp" />
                                        </DockPanel>
                                    </Border>
                                    <DockPanel Width="420">
                                        <TextBlock x:Name="SideChannelHeader" DockPanel.Dock="Top" Margin="18,20,18,8" FontSize="11"
                                                   FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock DockPanel.Dock="Bottom" Margin="18,8,18,16" FontSize="12" TextWrapping="Wrap"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   Text="{x:Static loc:Strings.SidePanelHint}" />
                                        <ListBox x:Name="SideChannelList" Focusable="False"
                                                 ItemTemplate="{StaticResource ChannelTemplate}"
                                                 ItemContainerStyle="{StaticResource SideListItem}"
                                                 VirtualizingPanel.ScrollUnit="Item"
                                                 PreviewMouseLeftButtonUp="SideChannelList_PreviewMouseLeftButtonUp" />
                                    </DockPanel>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </vlc:VideoView>
                </Border>

                <!-- Now playing (windowed mode) -->
                <StackPanel x:Name="NowPlayingPanel" Grid.Row="1" Margin="2,16,2,0">
                    <TextBlock x:Name="NowPlayingName" FontSize="20" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" Text=" " />
                    <TextBlock x:Name="NowPlayingGroup" FontSize="13" Margin="0,3,0,0"
                               Foreground="{StaticResource SubTextBrush}" TextTrimming="CharacterEllipsis" />

                    <!-- VOD (Movie/episode) transport controls — see UpdateVodControls. Live TV never shows this. -->
                    <DockPanel x:Name="VodControlRow" Margin="0,14,0,0" LastChildFill="True" Visibility="Collapsed">
                        <Button x:Name="PlayPauseButton" DockPanel.Dock="Left" Width="36" Height="36" Margin="0,0,16,0"
                                Padding="0" FontFamily="Segoe MDL2 Assets" FontSize="14" Click="PlayPauseButton_Click" />
                        <TextBlock x:Name="SeekTimeText" DockPanel.Dock="Right" Margin="16,0,0,0" VerticalAlignment="Center"
                                   Foreground="{StaticResource SubTextBrush}" FontSize="13" MinWidth="110" TextAlignment="Right" />
                        <Slider x:Name="SeekSlider" VerticalAlignment="Center" Minimum="0" Maximum="0" Value="0"
                                IsMoveToPointEnabled="True"
                                PreviewMouseLeftButtonDown="SeekSlider_PreviewMouseLeftButtonDown"
                                PreviewMouseLeftButtonUp="SeekSlider_PreviewMouseLeftButtonUp"
                                PreviewKeyUp="SeekSlider_PreviewKeyUp" />
                    </DockPanel>

                    <StackPanel Margin="0,12,0,0">
                        <TextBlock x:Name="EpgNowText" FontSize="13" TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                        <TextBlock x:Name="EpgNextText" FontSize="12" Margin="0,4,0,0"
                                   Foreground="{StaticResource SubTextBrush}" TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                        <TextBlock x:Name="EpgAfterText" FontSize="12" Margin="0,4,0,0"
                                   Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ===== Welcome / load error panel (shown instead of ContentGrid) ===== -->
        <Border x:Name="WelcomePanel" Grid.Row="1" Visibility="Collapsed" Background="{StaticResource BackgroundBrush}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560">
                <TextBlock x:Name="WelcomeTitle" FontSize="28" FontWeight="SemiBold" TextAlignment="Center"
                           Text="{x:Static loc:Strings.WelcomeTitle}" />
                <TextBlock x:Name="WelcomeMessage" FontSize="15" Margin="0,12,0,0" TextAlignment="Center"
                           TextWrapping="Wrap" Foreground="{StaticResource SubTextBrush}"
                           Text="{x:Static loc:Strings.WelcomeMessage}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,28,0,0">
                    <Button x:Name="WelcomeRetryButton" Content="{x:Static loc:Strings.TryAgainButton}" Margin="0,0,10,0"
                            Visibility="Collapsed" Click="ReloadButton_Click" />
                    <Button x:Name="WelcomeSourceButton" Content="{x:Static loc:Strings.AddPlaylistButton}" Style="{StaticResource AccentButton}"
                            Click="WelcomeSourceButton_Click" />
                </StackPanel>
                <StackPanel x:Name="WelcomeLanguagePanel" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                    <Button x:Name="WelcomeLanguageEnButton" Content="{x:Static loc:Strings.LanguageEnglishShort}"
                            Width="44" Padding="0,5" Margin="0,0,6,0" Click="WelcomeLanguageEnButton_Click" />
                    <Button x:Name="WelcomeLanguagePtButton" Content="{x:Static loc:Strings.LanguagePortugueseShort}"
                            Width="44" Padding="0,5" Click="WelcomeLanguagePtButton_Click" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
