<Window x:Class="ZecaTV.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ZecaTV.Localization"
        Title="{x:Static loc:Strings.SettingsTitle}"
        Width="560" Height="700" MaxHeight="700" MinHeight="360"
        SizeToContent="Height"
        ResizeMode="CanResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="SectionBody" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelAltBrush}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Margin" Value="0,0,0,18" />
        </Style>
        <DataTemplate x:Key="PlaylistRowTemplate">
            <Border Background="{StaticResource PanelBrush}" CornerRadius="6" Padding="12,9" Margin="0,0,0,6">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="{x:Static loc:Strings.SwitchButton}" Margin="0,0,8,0" Visibility="{Binding SwitchVisibility}"
                                Click="SwitchPlaylist_Click" Tag="{Binding Playlist}" />
                        <Button Content="{x:Static loc:Strings.EditButton}" Margin="0,0,8,0" Click="EditPlaylist_Click" Tag="{Binding Playlist}" />
                        <Button Content="{x:Static loc:Strings.RemoveButton}" Click="RemovePlaylist_Click" Tag="{Binding Playlist}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,10,0">
                        <DockPanel>
                            <TextBlock Text="{x:Static loc:Strings.ActiveBadge}" FontSize="10" FontWeight="Bold" Foreground="#4FA3FF"
                                       Margin="0,0,8,0" VerticalAlignment="Center" Visibility="{Binding ActiveBadgeVisibility}" />
                            <TextBlock Text="{Binding Playlist.Name}" FontSize="13" FontWeight="SemiBold"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <TextBlock Text="{Binding SourceSummary}" FontSize="12" Margin="0,2,0,0"
                                   Foreground="{StaticResource SubTextBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="CategoryOverrideRowTemplate">
            <Border Background="{StaticResource PanelBrush}" CornerRadius="6" Padding="12,9" Margin="0,0,0,6">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="{x:Static loc:Strings.RemoveButton}"
                            Click="RemoveCategoryOverride_Click" Tag="{Binding GroupTitle}" />
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="{Binding GroupTitle}" FontSize="13" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding GroupTitle}" />
                        <TextBlock Text="{Binding TypeLabel}" FontSize="12" Margin="0,2,0,0" Foreground="{StaticResource SubTextBrush}" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <DockPanel Margin="26,22,26,20">
        <TextBlock DockPanel.Dock="Top" Text="{x:Static loc:Strings.SettingsTitle}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,18" />
        <Button DockPanel.Dock="Bottom" x:Name="CloseButton" Content="{x:Static loc:Strings.CloseButton}" IsCancel="True" IsDefault="True"
                Style="{StaticResource AccentButton}" HorizontalAlignment="Right" Margin="0,16,0,0" />

        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,-16,0" Padding="0,0,16,0">
        <StackPanel>
        <TextBlock Text="{x:Static loc:Strings.LanguageSection}" Style="{StaticResource SectionTitle}" />
        <Border Style="{StaticResource SectionBody}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="LanguageEnButton" Content="{x:Static loc:Strings.LanguageEnglish}" Margin="0,0,8,0"
                            Click="LanguageEnButton_Click" />
                    <Button x:Name="LanguagePtButton" Content="{x:Static loc:Strings.LanguagePortuguese}" Click="LanguagePtButton_Click" />
                </StackPanel>
                <TextBlock x:Name="LanguageNoteText" Text="{x:Static loc:Strings.LanguageChangedNote}" FontSize="12" Margin="0,10,0,0"
                           TextWrapping="Wrap" Foreground="{StaticResource SubTextBrush}" Visibility="Collapsed" />
            </StackPanel>
        </Border>

        <TextBlock Text="{x:Static loc:Strings.PlaylistsSection}" Style="{StaticResource SectionTitle}" />
        <Border Style="{StaticResource SectionBody}">
            <StackPanel>
                <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="PlaylistsList" ItemTemplate="{StaticResource PlaylistRowTemplate}" />
                </ScrollViewer>
                <Button Content="{x:Static loc:Strings.AddPlaylistEllipsisButton}" HorizontalAlignment="Left" Margin="0,10,0,0" Click="AddPlaylistButton_Click" />
            </StackPanel>
        </Border>

        <TextBlock Text="{x:Static loc:Strings.CategoryOverridesSection}" Style="{StaticResource SectionTitle}" />
        <Border Style="{StaticResource SectionBody}">
            <StackPanel>
                <TextBlock Text="{x:Static loc:Strings.CategoryOverridesBody}" TextWrapping="Wrap"
                           Foreground="{StaticResource SubTextBrush}" Margin="0,0,0,10" />
                <TextBlock x:Name="NoCategoryOverridesText" Text="{x:Static loc:Strings.NoCategoryOverridesYet}"
                           TextWrapping="Wrap" Foreground="{StaticResource SubTextBrush}" Visibility="Collapsed" />
                <ScrollViewer x:Name="CategoryOverridesScroll" MaxHeight="220" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="CategoryOverridesList" ItemTemplate="{StaticResource CategoryOverrideRowTemplate}" />
                </ScrollViewer>
            </StackPanel>
        </Border>

        <TextBlock Text="{x:Static loc:Strings.EpgSection}" Style="{StaticResource SectionTitle}" />
        <Border Style="{StaticResource SectionBody}">
            <StackPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="{x:Static loc:Strings.ManageSourcesButton}" VerticalAlignment="Top" Click="ManageEpgSourcesButton_Click" />
                    <TextBlock x:Name="EpgSummaryText" TextWrapping="Wrap" Margin="0,0,12,0" VerticalAlignment="Center" />
                </DockPanel>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button x:Name="ReloadEpgButton" Content="{x:Static loc:Strings.ReloadAllGuideDataButton}" Click="ReloadEpgButton_Click" />
                    <Button Content="{x:Static loc:Strings.AssignChannelEpgButton}" Margin="10,0,0,0" Click="AssignChannelEpgButton_Click" />
                </StackPanel>
            </StackPanel>
        </Border>

        <TextBlock Text="{x:Static loc:Strings.PlaybackSection}" Style="{StaticResource SectionTitle}" />
        <Border Style="{StaticResource SectionBody}">
            <StackPanel>
                <CheckBox x:Name="ResumeChannelCheck" Content="{x:Static loc:Strings.ResumeLastChannelCheckbox}"
                          Checked="ResumeChannelCheck_Changed" Unchecked="ResumeChannelCheck_Changed" />
                <CheckBox x:Name="BackgroundRefreshCheck" Content="{x:Static loc:Strings.BackgroundRefreshCheckbox}"
                          Margin="0,10,0,0" Checked="BackgroundRefreshCheck_Changed" Unchecked="BackgroundRefreshCheck_Changed" />
                <DockPanel Margin="24,8,0,0" LastChildFill="False">
                    <TextBlock Text="{x:Static loc:Strings.BackgroundRefreshIntervalLabel}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <ComboBox x:Name="BackgroundRefreshIntervalCombo" Width="100" HorizontalAlignment="Left"
                              SelectionChanged="BackgroundRefreshIntervalCombo_SelectionChanged" />
                </DockPanel>
            </StackPanel>
        </Border>

        <TextBlock Text="{x:Static loc:Strings.WindowSection}" Style="{StaticResource SectionTitle}" />
        <Border Style="{StaticResource SectionBody}">
            <CheckBox x:Name="MinimizeToTrayCheck" Content="{x:Static loc:Strings.MinimizeToTrayCheckbox}"
                      Checked="MinimizeToTrayCheck_Changed" Unchecked="MinimizeToTrayCheck_Changed" />
        </Border>

        <TextBlock Text="{x:Static loc:Strings.BackupSection}" Style="{StaticResource SectionTitle}" />
        <Border Style="{StaticResource SectionBody}">
            <StackPanel>
                <TextBlock Text="{x:Static loc:Strings.BackupSectionBody}" TextWrapping="Wrap"
                           Foreground="{StaticResource SubTextBrush}" Margin="0,0,0,10" />
                <StackPanel Orientation="Horizontal">
                    <Button Content="{x:Static loc:Strings.BackupButton}" Margin="0,0,8,0" Click="BackupButton_Click" />
                    <Button Content="{x:Static loc:Strings.RestoreButton}" Click="RestoreButton_Click" />
                </StackPanel>
                <TextBlock x:Name="BackupStatusText" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
            </StackPanel>
        </Border>

        <TextBlock Text="{x:Static loc:Strings.ControlsSection}" Style="{StaticResource SectionTitle}" />
        <Border Style="{StaticResource SectionBody}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="{x:Static loc:Strings.ViewControlsButton}" VerticalAlignment="Top" Click="ViewControlsButton_Click" />
                <TextBlock Text="{x:Static loc:Strings.ControlsSectionBody}"
                           TextWrapping="Wrap" Margin="0,0,12,0" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <TextBlock Text="{x:Static loc:Strings.M3uEditorSection}" Style="{StaticResource SectionTitle}" />
        <Border Style="{StaticResource SectionBody}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="{x:Static loc:Strings.OpenM3uEditorButton}" VerticalAlignment="Top" Click="OpenM3uEditorButton_Click" />
                <TextBlock Text="{x:Static loc:Strings.M3uEditorSectionBody}"
                           TextWrapping="Wrap" Margin="0,0,12,0" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <TextBlock Text="{x:Static loc:Strings.AboutSection}" Style="{StaticResource SectionTitle}" />
        <Border Style="{StaticResource SectionBody}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="{x:Static loc:Strings.OpenLogsFolderButton}" VerticalAlignment="Top" Click="OpenLogsButton_Click" />
                <TextBlock x:Name="VersionText" VerticalAlignment="Center" Foreground="{StaticResource SubTextBrush}" />
            </DockPanel>
        </Border>
        </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
