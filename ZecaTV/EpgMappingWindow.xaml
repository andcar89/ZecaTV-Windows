<Window x:Class="ZecaTV.EpgMappingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ZecaTV.Localization"
        Title="{x:Static loc:Strings.AssignChannelEpgTitle}"
        Width="560" Height="620" MinWidth="480" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI">

    <Window.Resources>
        <DataTemplate x:Key="MappingRowTemplate">
            <Border Background="{StaticResource PanelAltBrush}" CornerRadius="6" Padding="12,9" Margin="0,0,0,6">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="{x:Static loc:Strings.RemoveButton}" Click="RemoveMapping_Click" Tag="{Binding ChannelKey}" />
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="{Binding ChannelName}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Detail}" FontSize="12" Margin="0,2,0,0"
                                   Foreground="{StaticResource SubTextBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <DockPanel Margin="26,22,26,20">
        <TextBlock DockPanel.Dock="Top" Text="{x:Static loc:Strings.AssignChannelEpgTitle}" FontSize="18" FontWeight="SemiBold" />
        <TextBlock DockPanel.Dock="Top" Margin="0,4,0,0" FontSize="13" TextWrapping="Wrap"
                   Foreground="{StaticResource SubTextBrush}"
                   Text="{x:Static loc:Strings.AssignChannelEpgIntro}" />

        <TextBlock DockPanel.Dock="Top" Text="{x:Static loc:Strings.ChannelLabel}" Style="{StaticResource FieldLabel}" />
        <ComboBox DockPanel.Dock="Top" x:Name="ChannelCombo" DisplayMemberPath="Name" SelectionChanged="ChannelCombo_SelectionChanged" />

        <TextBlock DockPanel.Dock="Top" Text="{x:Static loc:Strings.GuideSourceLabel}" Style="{StaticResource FieldLabel}" />
        <ComboBox DockPanel.Dock="Top" x:Name="SourceCombo" DisplayMemberPath="Name" SelectionChanged="SourceCombo_SelectionChanged" />

        <TextBlock DockPanel.Dock="Top" Text="{x:Static loc:Strings.GuideChannelLabel}" Style="{StaticResource FieldLabel}" />
        <ComboBox DockPanel.Dock="Top" x:Name="GuideChannelCombo" DisplayMemberPath="Name" />

        <TextBlock DockPanel.Dock="Top" x:Name="MessageText" Margin="0,14,0,0" FontSize="13" TextWrapping="Wrap" Visibility="Collapsed" />

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="ClearButton" Content="{x:Static loc:Strings.RemoveThisMappingButton}" Margin="0,0,10,0" Visibility="Collapsed"
                    Click="ClearButton_Click" />
            <Button x:Name="CancelButton" Content="{x:Static loc:Strings.CloseButton}" IsCancel="True" Margin="0,0,10,0" />
            <Button x:Name="SaveButton" Content="{x:Static loc:Strings.SaveButton}" IsDefault="True" Style="{StaticResource AccentButton}"
                    Click="SaveButton_Click" />
        </StackPanel>

        <TextBlock DockPanel.Dock="Top" Text="{x:Static loc:Strings.CurrentMappingsHeader}" Margin="0,22,0,8" FontSize="11" FontWeight="SemiBold"
                   Foreground="{StaticResource MutedTextBrush}" />

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="MappingsList" ItemTemplate="{StaticResource MappingRowTemplate}" />
        </ScrollViewer>
    </DockPanel>
</Window>
