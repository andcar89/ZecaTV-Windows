<Window x:Class="ZecaTV.EpgSourcesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ZecaTV.Localization"
        Title="{x:Static loc:Strings.EpgSourcesTitle}"
        Width="640" Height="620" MinHeight="420" MaxHeight="760"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI">

    <Window.Resources>
        <DataTemplate x:Key="SourceRowTemplate">
            <Border Background="{StaticResource PanelAltBrush}" CornerRadius="6" Padding="14,10" Margin="0,0,0,8">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="{x:Static loc:Strings.RemoveButton}" Margin="10,0,0,0"
                            Visibility="{Binding CanRemove}" Click="RemoveSource_Click" Tag="{Binding Id}" />
                    <Button DockPanel.Dock="Right" Content="{x:Static loc:Strings.ReloadButton}" Margin="10,0,0,0"
                            Click="ReloadSource_Click" Tag="{Binding Id}" />
                    <Button DockPanel.Dock="Right" Content="{Binding ToggleActiveText}" Margin="10,0,0,0"
                            Click="ToggleActive_Click" Tag="{Binding Id}" />
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="{x:Static loc:Strings.ActiveBadge}" FontSize="10" FontWeight="Bold" Foreground="#4FA3FF"
                                       Margin="0,0,8,0" VerticalAlignment="Center" Visibility="{Binding ActiveBadgeVisibility}" />
                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <TextBlock Text="{Binding Url}" FontSize="12" Margin="0,2,0,4"
                                   Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{Binding StatusBrush}" />
                        <TextBlock Text="{x:Static loc:Strings.ActiveSourceNote}" FontSize="11" Margin="0,4,0,0"
                                   Foreground="#4FA3FF" Visibility="{Binding ActiveBadgeVisibility}" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <DockPanel Margin="24,20,24,20">
        <TextBlock DockPanel.Dock="Top" Text="{x:Static loc:Strings.EpgSourcesTitle}" FontSize="18" FontWeight="SemiBold" />
        <TextBlock DockPanel.Dock="Top" Margin="0,4,0,16" FontSize="13" TextWrapping="Wrap"
                   Foreground="{StaticResource SubTextBrush}"
                   Text="{x:Static loc:Strings.EpgSourcesIntro}" />

        <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelAltBrush}" CornerRadius="6" Padding="14" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock Text="{x:Static loc:Strings.AddXmltvSourceHeading}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" />
                <TextBlock Text="{x:Static loc:Strings.NameLabel}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                <TextBox x:Name="NameBox" />
                <TextBlock Text="{x:Static loc:Strings.XmltvUrlLabel}" Style="{StaticResource FieldLabel}" Margin="0,10,0,4" />
                <TextBox x:Name="UrlBox" />
                <TextBlock x:Name="AddMessageText" Margin="0,10,0,0" FontSize="13" Foreground="{StaticResource ErrorBrush}"
                           TextWrapping="Wrap" Visibility="Collapsed" />
                <Button x:Name="AddButton" Content="{x:Static loc:Strings.AddAndLoadButton}" Style="{StaticResource AccentButton}"
                        HorizontalAlignment="Right" Margin="0,12,0,0" Click="AddButton_Click" />
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="SourcesList" ItemTemplate="{StaticResource SourceRowTemplate}" />
        </ScrollViewer>
    </DockPanel>
</Window>
