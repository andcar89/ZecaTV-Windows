<Window x:Class="ZecaTV.ControlsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ZecaTV.Localization"
        Title="{x:Static loc:Strings.ControlsTitle}"
        Width="520" Height="600" MinHeight="400"
        ResizeMode="CanResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="ControlRow" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelAltBrush}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="ActionText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="KeysText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource SubTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Margin" Value="16,0,0,0" />
        </Style>
        <Style x:Key="GroupTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="Margin" Value="0,14,0,8" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="26,22,26,20">
        <TextBlock DockPanel.Dock="Top" Text="{x:Static loc:Strings.ControlsTitle}" FontSize="18" FontWeight="SemiBold" />
        <Button DockPanel.Dock="Bottom" Content="{x:Static loc:Strings.CloseButton}" IsCancel="True" IsDefault="True"
                Style="{StaticResource AccentButton}" HorizontalAlignment="Right" Margin="0,16,0,0" />

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="{x:Static loc:Strings.GroupPlayback}" Style="{StaticResource GroupTitle}" Margin="0,0,0,8" />
                <Border Style="{StaticResource ControlRow}"><DockPanel>
                    <TextBlock Style="{StaticResource KeysText}" DockPanel.Dock="Right" Text="{x:Static loc:Strings.KeysClickOrEnter}" />
                    <TextBlock Style="{StaticResource ActionText}" Text="{x:Static loc:Strings.ActionPreviewChannel}" /></DockPanel></Border>
                <Border Style="{StaticResource ControlRow}"><DockPanel>
                    <TextBlock Style="{StaticResource KeysText}" DockPanel.Dock="Right" Text="{x:Static loc:Strings.KeysFullscreen}" />
                    <TextBlock Style="{StaticResource ActionText}" Text="{x:Static loc:Strings.ActionFullscreen}" /></DockPanel></Border>
                <Border Style="{StaticResource ControlRow}"><DockPanel>
                    <TextBlock Style="{StaticResource KeysText}" DockPanel.Dock="Right" Text="{x:Static loc:Strings.KeysExitFullscreen}" />
                    <TextBlock Style="{StaticResource ActionText}" Text="{x:Static loc:Strings.ActionExitFullscreen}" /></DockPanel></Border>
                <Border Style="{StaticResource ControlRow}"><DockPanel>
                    <TextBlock Style="{StaticResource KeysText}" DockPanel.Dock="Right" Text="{x:Static loc:Strings.KeysArrowsPgUpDn}" />
                    <TextBlock Style="{StaticResource ActionText}" Text="{x:Static loc:Strings.ActionChangeChannelFullscreen}" /></DockPanel></Border>
                <Border Style="{StaticResource ControlRow}"><DockPanel>
                    <TextBlock Style="{StaticResource KeysText}" DockPanel.Dock="Right" Text="{x:Static loc:Strings.KeysPauseResume}" />
                    <TextBlock Style="{StaticResource ActionText}" Text="{x:Static loc:Strings.ActionPauseResume}" /></DockPanel></Border>
                <Border Style="{StaticResource ControlRow}"><DockPanel>
                    <TextBlock Style="{StaticResource KeysText}" DockPanel.Dock="Right" Text="{x:Static loc:Strings.KeysSeek}" />
                    <TextBlock Style="{StaticResource ActionText}" Text="{x:Static loc:Strings.ActionSeek}" /></DockPanel></Border>
                <Border Style="{StaticResource ControlRow}"><DockPanel>
                    <TextBlock Style="{StaticResource KeysText}" DockPanel.Dock="Right" Text="{x:Static loc:Strings.KeysVolume}" />
                    <TextBlock Style="{StaticResource ActionText}" Text="{x:Static loc:Strings.ActionVolume}" /></DockPanel></Border>
                <Border Style="{StaticResource ControlRow}"><DockPanel>
                    <TextBlock Style="{StaticResource KeysText}" DockPanel.Dock="Right" Text="M" />
                    <TextBlock Style="{StaticResource ActionText}" Text="{x:Static loc:Strings.ActionMute}" /></DockPanel></Border>
                <Border Style="{StaticResource ControlRow}"><DockPanel>
                    <TextBlock Style="{StaticResource KeysText}" DockPanel.Dock="Right" Text="{x:Static loc:Strings.KeysAudioSubtitles}" />
                    <TextBlock Style="{StaticResource ActionText}" Text="{x:Static loc:Strings.ActionAudioSubtitles}" /></DockPanel></Border>
                <Border Style="{StaticResource ControlRow}"><DockPanel>
                    <TextBlock Style="{StaticResource KeysText}" DockPanel.Dock="Right" Text="{x:Static loc:Strings.KeysDirectChannel}" />
                    <TextBlock Style="{StaticResource ActionText}" Text="{x:Static loc:Strings.ActionDirectChannel}" /></DockPanel></Border>
                <Border Style="{StaticResource ControlRow}"><DockPanel>
                    <TextBlock Style="{StaticResource KeysText}" DockPanel.Dock="Right" Text="F5" />
                    <TextBlock Style="{StaticResource ActionText}" Text="{x:Static loc:Strings.ActionReloadPlaylist}" /></DockPanel></Border>

                <TextBlock Text="{x:Static loc:Strings.GroupBrowsing}" Style="{StaticResource GroupTitle}" />
                <Border Style="{StaticResource ControlRow}"><DockPanel>
                    <TextBlock Style="{StaticResource KeysText}" DockPanel.Dock="Right" Text="{x:Static loc:Strings.KeysSearch}" />
                    <TextBlock Style="{StaticResource ActionText}" Text="{x:Static loc:Strings.ActionSearchAllChannels}" /></DockPanel></Border>
                <Border Style="{StaticResource ControlRow}"><DockPanel>
                    <TextBlock Style="{StaticResource KeysText}" DockPanel.Dock="Right" Text="{x:Static loc:Strings.KeysBrowseMoviesShows}" />
                    <TextBlock Style="{StaticResource ActionText}" Text="{x:Static loc:Strings.ActionBrowseMoviesShows}" /></DockPanel></Border>
                <Border Style="{StaticResource ControlRow}"><DockPanel>
                    <TextBlock Style="{StaticResource KeysText}" DockPanel.Dock="Right" Text="← / →" />
                    <TextBlock Style="{StaticResource ActionText}" Text="{x:Static loc:Strings.ActionMoveCategoriesChannels}" /></DockPanel></Border>
                <Border Style="{StaticResource ControlRow}"><DockPanel>
                    <TextBlock Style="{StaticResource KeysText}" DockPanel.Dock="Right" Text="{x:Static loc:Strings.KeysChannelListFullscreen}" />
                    <TextBlock Style="{StaticResource ActionText}" Text="{x:Static loc:Strings.ActionChannelListFullscreen}" /></DockPanel></Border>
                <Border Style="{StaticResource ControlRow}"><DockPanel>
                    <TextBlock Style="{StaticResource KeysText}" DockPanel.Dock="Right" Text="{x:Static loc:Strings.KeysBackFromEpisodes}" />
                    <TextBlock Style="{StaticResource ActionText}" Text="{x:Static loc:Strings.ActionBackFromEpisodes}" /></DockPanel></Border>
                <Border Style="{StaticResource ControlRow}"><DockPanel>
                    <TextBlock Style="{StaticResource KeysText}" DockPanel.Dock="Right" Text="{x:Static loc:Strings.KeysFavorite}" />
                    <TextBlock Style="{StaticResource ActionText}" Text="{x:Static loc:Strings.ActionAddRemoveFavorite}" /></DockPanel></Border>
                <Border Style="{StaticResource ControlRow}"><DockPanel>
                    <TextBlock Style="{StaticResource KeysText}" DockPanel.Dock="Right" Text="{x:Static loc:Strings.KeysChannelOptionsMenu}" />
                    <TextBlock Style="{StaticResource ActionText}" Text="{x:Static loc:Strings.ActionChannelOptionsMenu}" /></DockPanel></Border>
                <Border Style="{StaticResource ControlRow}"><DockPanel>
                    <TextBlock Style="{StaticResource KeysText}" DockPanel.Dock="Right" Text="{x:Static loc:Strings.KeysSwitchPlaylist}" />
                    <TextBlock Style="{StaticResource ActionText}" Text="{x:Static loc:Strings.ActionSwitchPlaylist}" /></DockPanel></Border>
                <Border Style="{StaticResource ControlRow}"><DockPanel>
                    <TextBlock Style="{StaticResource KeysText}" DockPanel.Dock="Right" Text="{x:Static loc:Strings.KeysOpenTvGuide}" />
                    <TextBlock Style="{StaticResource ActionText}" Text="{x:Static loc:Strings.ActionOpenTvGuide}" /></DockPanel></Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
